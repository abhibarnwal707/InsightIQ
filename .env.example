# Required for the real OpenRouter API. Get one at https://openrouter.ai/keys
# Leave blank if OPENROUTER_BASE_URL below points at a local OpenAI-compatible
# router (e.g. OmniRoute) instead -- no key is sent when this is empty.
OPENROUTER_API_KEY=

# Optional overrides — sane defaults live in insightiq/app/config.py.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# To use a local router instead of OpenRouter (e.g. when the free tier is
# exhausted), point this at it and set OPENROUTER_MODELS=auto below:
# OPENROUTER_BASE_URL=http://localhost:20128/v1

# Comma-separated fallback list, tried in order. Leave unset to use the 16-model
# default in app/config.py (DEFAULT_OPENROUTER_MODELS).
#
# Length matters: the free-tier daily cap is PER MODEL, so 16 models = 16x the daily
# headroom (800 calls/day at the default 50). Free-model capacity is also shared
# across every OpenRouter user, so several models being 429 at any given moment is
# normal — a long list is what keeps a run alive through that.
#
# The free-model roster rotates frequently — check https://openrouter.ai/api/v1/models
# (filter for ids ending in ":free") rather than trusting the default indefinitely.
# OPENROUTER_MODELS=z-ai/glm-5.2:free,minimax/minimax-m3:free,google/gemma-4-31b-it:free
#
# For a local router that self-selects the model (e.g. OmniRoute's "auto"):
# OPENROUTER_MODELS=auto

# Max concurrent OpenRouter requests in flight at once. Free tier is 20 req/min —
# keep this low (2-3) to avoid blowing through it when several agents run at once.
# OPENROUTER_MAX_CONCURRENCY=3

# Free tier: 50 calls/day normally, 1000/day once you've ever bought $10+ in
# OpenRouter credits. Raise this once you've done that. Not a meaningful limit
# for a local router -- set it high (e.g. 10000) when using one.
# OPENROUTER_DAILY_CALL_BUDGET=50

# OPENROUTER_MAX_RETRIES=4

# SEC EDGAR requires a descriptive User-Agent identifying you (fair-access policy).
# Set this to "YourApp your-real-email@example.com" or EDGAR will start rejecting requests.
EDGAR_USER_AGENT=InsightIQ research-agent contact@example.com
# EDGAR_BASE_URL=https://www.sec.gov
# EDGAR_DATA_URL=https://data.sec.gov

# COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4
# GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# DB_PATH=insightiq.db
# CACHE_TTL_HOURS=24
